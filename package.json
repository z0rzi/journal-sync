{
	"name": "journal-sync",
	"version": "0.2.2",
	"description": "Git sync for the journal vault: commit and push after a quiet period, pull on a timer and on app focus, merge notes section by section.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"dependencies": {
		"buffer": "^6.0.3",
		"isomorphic-git": "^1.44.18",
		"node-diff3": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"git-http-mock-server": "^2.0.0",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^3.2.7"
	}
}
